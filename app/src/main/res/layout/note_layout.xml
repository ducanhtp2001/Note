<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#D5CFCF"
    android:padding="0dp">

    <!-- TextView mới nằm phía trên edit_time -->
    <TextView
        android:id="@+id/note_belong"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/abhaya_libre_medium"
        android:text="@string/note_belong"
        android:textAppearance="?android:attr/textAppearanceListItem"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/note_title"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:textAppearance="?android:attr/textAppearanceListItem"
        android:textSize="22sp"
        android:fontFamily="@font/abhaya_libre_medium"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/note_belong"
        app:layout_constraintEnd_toStartOf="@+id/pinBtn"/>

    <ImageView
        android:id="@+id/deleteBtn"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:padding="5dp"
        android:layout_margin="5dp"
        android:src="@drawable/ic_menu_trash"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/note_belong"/>

    <ImageView
        android:id="@+id/pinBtn"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:padding="5dp"
        android:layout_margin="5dp"
        android:src="@drawable/ic_pin"
        app:layout_constraintTop_toBottomOf="@+id/note_belong"
        app:layout_constraintEnd_toStartOf="@+id/deleteBtn"/>


    <TextView
        android:id="@+id/edit_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="?android:attr/textAppearanceListItem"
        android:textSize="12sp"
        android:fontFamily="@font/abhaya_libre_medium"
        android:layout_marginTop="0dp"
        android:layout_marginEnd="14dp"
        app:layout_constraintTop_toBottomOf="@+id/pinBtn"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>

